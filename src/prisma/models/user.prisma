model User{
    id          Int     @id @default(autoincrement()) @map("_id")
    username    String  @unique
    email       String  @unique
    password    String
    avatar      String?

    role        Role    @default(USER)

    sentMessageId   Int[]
    sentMessage     Message[]

    joinedWorkspaceId Int[]
    joinedWorkspace   WorkSpace[]
}